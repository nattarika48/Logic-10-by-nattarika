<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Logic Gates 4 Inputs - ว้าวเวอร์ชัน</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@400;700&display=swap');
  body {
    font-family: 'Kanit', sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #f0f0f0;
    margin: 0; padding: 20px;
    min-height: 100vh;
  }
  h2, h3 {
    text-align: center;
    text-shadow: 1px 1px 5px rgba(0,0,0,0.6);
  }
  .btn-container {
    text-align: center;
    margin-bottom: 20px;
  }
  button {
    background: #9f7aea;
    border: none;
    border-radius: 50%;
    width: 70px;
    height: 70px;
    margin: 10px;
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(159,122,234,0.6);
    transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
  }
  button:hover {
    background: #d6bcfa;
    color: #4a148c;
    box-shadow: 0 6px 20px rgba(214,188,250,0.8);
    transform: scale(1.1);
  }
  button:active {
    transform: scale(0.95);
    box-shadow: 0 3px 10px rgba(159,122,234,0.5);
  }
  #output {
    max-width: 400px;
    margin: 0 auto 30px;
    padding: 15px 25px;
    background: rgba(255 255 255 / 0.15);
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    font-size: 18px;
    line-height: 1.5;
    text-align: center;
  }
  table {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-collapse: collapse;
    background: rgba(255 255 255 / 0.12);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  th, td {
    padding: 10px 12px;
    border: 1px solid rgba(255 255 255 / 0.2);
    text-align: center;
    font-weight: 600;
  }
  th {
    background: #a78bfa;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }
  tr:nth-child(even) {
    background: rgba(255 255 255 / 0.08);
  }
  tr:hover {
    background: rgba(255 255 255 / 0.15);
  }
  footer {
    text-align: center;
    margin-top: 40px;
    color: #dcdcdcaa;
    font-size: 14px;
  }
</style>
</head>
<body>

<h2>🔧 Logic Gates Simulator (4 Inputs)</h2>

<div class="btn-container">
  <button onclick="toggle('A')" id="btnA">A: 0</button>
  <button onclick="toggle('B')" id="btnB">B: 0</button>
  <button onclick="toggle('C')" id="btnC">C: 0</button>
  <button onclick="toggle('D')" id="btnD">D: 0</button>
</div>

<div id="output">กดปุ่มอินพุตด้านบนเพื่อดูผลลัพธ์</div>

<h3>📋 ตารางความจริง (Truth Table)</h3>
<div id="truthTable"></div>

<script>
  let inputs = { A: 0, B: 0, C: 0, D: 0 };

  function toggle(input) {
    inputs[input] = inputs[input] === 0 ? 1 : 0;
    document.getElementById('btn' + input).innerText = input + ': ' + inputs[input];
    updateResults();
  }

  function calculateLogic(a, b, c, d) {
    const notA = a ^ 1;
    const and = a & b & c & d;
    const or = a | b | c | d;
    const xor = a ^ b ^ c ^ d;
    const nand = and ^ 1;
    const nor = or ^ 1;
    const xnor = xor ^ 1;
    return { notA, and, or, xor, nand, nor, xnor };
  }

  function updateResults() {
    const logic = calculateLogic(inputs.A, inputs.B, inputs.C, inputs.D);
    let html = `<b>ค่าอินพุตปัจจุบัน:</b> A=${inputs.A}, B=${inputs.B}, C=${inputs.C}, D=${inputs.D}<br><br>`;
    html += `<b>ผลลัพธ์ประตูลอจิก:</b><br>`;
    html += `NOT A: ${logic.notA}<br>`;
    html += `AND: ${logic.and}<br>`;
    html += `OR: ${logic.or}<br>`;
    html += `XOR: ${logic.xor}<br>`;
    html += `NAND: ${logic.nand}<br>`;
    html += `NOR: ${logic.nor}<br>`;
    html += `XNOR: ${logic.xnor}<br>`;
    document.getElementById('output').innerHTML = html;
  }

  function generateTruthTable() {
    let table = '<table><tr><th>A</th><th>B</th><th>C</th><th>D</th><th>NOT A</th><th>AND</th><th>OR</th><th>XOR</th><th>NAND</th><th>NOR</th><th>XNOR</th></tr>';

    for (let i = 0; i < 16; i++) {
      const a = (i >> 3) & 1;
      const b = (i >> 2) & 1;
      const c = (i >> 1) & 1;
      const d = i & 1;
      const logic = calculateLogic(a, b, c, d);
      table += `<tr>
                  <td>${a}</td><td>${b}</td><td>${c}</td><td>${d}</td>
                  <td>${logic.notA}</td><td>${logic.and}</td><td>${logic.or}</td><td>${logic.xor}</td>
                  <td>${logic.nand}</td><td>${logic.nor}</td><td>${logic.xnor}</td>
                </tr>`;
    }

    table += '</table>';
    document.getElementById('truthTable').innerHTML = table;
  }

  updateResults();
  generateTruthTable();
</script>

<footer>
  © 2025 Logic Gates Simulator by You
</footer>

</body>
</html>